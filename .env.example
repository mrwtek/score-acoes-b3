# Copie este arquivo para .env e preencha com os seus tokens.
# O .env esta no .gitignore e nunca deve ser versionado.
#
# O carregamento falha de proposito se faltar token: antes disso, um .env
# fora do lugar devolvia token nulo, o requests descartava o parametro sem
# erro, e a API respondia como se a chamada fosse anonima.

# https://brapi.dev - plano gratuito
BRAPI_TOKEN=

# BolsAI - plano gratuito  [PREENCHER a URL de cadastro]
BOLSAI_TOKEN=

# A API do Banco Central (SGS) e aberta e nao exige token.
